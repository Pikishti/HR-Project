generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- Shared: People / Org Chart ----------

model Person {
  id         String   @id @default(cuid())
  name       String
  email      String   @unique
  title      String?
  department String?
  avatarColor String  @default("#6366f1")
  status     String   @default("active") // active | inactive
  managerId  String?
  manager    Person?  @relation("ManagerReports", fields: [managerId], references: [id])
  reports    Person[] @relation("ManagerReports")
  createdAt  DateTime @default(now())

  assignedTasks  Task[]        @relation("TaskAssignee")
  comments       Comment[]
  ownedGoals     Goal[]        @relation("GoalOwner")
  kpis           Kpi[]
  strikeRecords  StrikeRecord[] @relation("StrikeSubject")
  issuedStrikes  StrikeRecord[] @relation("StrikeIssuer")
}

// ---------- Projects / Tasks ----------

model Project {
  id          String    @id @default(cuid())
  name        String
  description String?
  color       String    @default("#6366f1")
  status      String    @default("active") // active | archived
  createdAt   DateTime  @default(now())
  sections    Section[]
  tasks       Task[]
}

model Section {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  order     Int     @default(0)
  tasks     Task[]
}

model Task {
  id           String    @id @default(cuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sectionId    String?
  section      Section?  @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  parentTaskId String?
  parentTask   Task?     @relation("Subtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks     Task[]    @relation("Subtasks")
  name         String
  description  String?
  assigneeId   String?
  assignee     Person?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  dueDate      DateTime?
  priority     String    @default("medium") // low | medium | high
  completed    Boolean   @default(false)
  order        Int       @default(0)
  createdAt    DateTime  @default(now())

  tags     TaskTag[]
  comments Comment[]
}

model Tag {
  id    String    @id @default(cuid())
  name  String    @unique
  color String    @default("#94a3b8")
  tasks TaskTag[]
}

model TaskTag {
  taskId String
  tagId  String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
}

model Comment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    Person   @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())
}

// ---------- Performance: KPIs / Goals ----------

model KpiSet {
  id          String @id @default(cuid())
  name        String
  description String?
  kpis        Kpi[]
  createdAt   DateTime @default(now())
}

model Kpi {
  id           String   @id @default(cuid())
  kpiSetId     String
  kpiSet       KpiSet   @relation(fields: [kpiSetId], references: [id], onDelete: Cascade)
  name         String
  metricUnit   String?
  targetValue  Float
  currentValue Float    @default(0)
  personId     String?
  person       Person?  @relation(fields: [personId], references: [id], onDelete: SetNull)
  period       String   @default("quarterly") // weekly | monthly | quarterly | annual
  status       String   @default("on-track") // on-track | at-risk | off-track | done
  createdAt    DateTime @default(now())
  goals        Goal[]
}

model Goal {
  id          String    @id @default(cuid())
  title       String
  description String?
  ownerId     String
  owner       Person    @relation("GoalOwner", fields: [ownerId], references: [id])
  kpiId       String?
  kpi         Kpi?      @relation(fields: [kpiId], references: [id], onDelete: SetNull)
  targetDate  DateTime?
  progress    Int       @default(0) // 0-100
  status      String    @default("on-track") // on-track | at-risk | off-track | done
  createdAt   DateTime  @default(now())
}

// ---------- Performance: Strike / Discipline System ----------

model InfractionCategory {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  tiers       StrikeTier[]
  records     StrikeRecord[]
  createdAt   DateTime     @default(now())
}

model StrikeTier {
  id                     String              @id @default(cuid())
  categoryId             String
  category               InfractionCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name                   String
  level                  Int                 // ladder order, 1 = first/mildest
  consequenceDescription String?
  records                StrikeRecord[]
}

model StrikeRecord {
  id          String              @id @default(cuid())
  personId    String
  person      Person              @relation("StrikeSubject", fields: [personId], references: [id], onDelete: Cascade)
  categoryId  String
  category    InfractionCategory  @relation(fields: [categoryId], references: [id])
  tierId      String
  tier        StrikeTier          @relation(fields: [tierId], references: [id])
  reason      String
  issuedById  String?
  issuedBy    Person?             @relation("StrikeIssuer", fields: [issuedById], references: [id], onDelete: SetNull)
  dateIssued  DateTime            @default(now())
  expiresAt   DateTime?
  notes       String?
}
